<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately a single square button: one tap, one meaning, readable at a 1x1 cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/widget_bg_grey">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_widget_unlock"
        android:contentDescription="@string/widget_description" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_state_off"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:includeFontPadding="false" />
</LinearLayout>
