<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the gradient used by the 512px Play store icon so the launcher and the
     store listing read as the same mark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#17284A"
        android:endColor="#090F1C" />
</shape>
